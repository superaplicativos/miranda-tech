---
// src/pages/contato.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const pageTitle = "Solicitar Orçamento e Suporte Técnico | Miranda Tech";
const pageDescription = "Entre em contato direto com Guilherme Miranda. Solicite orçamentos para criação de sites, tráfego pago, SEO e integrações digitais corporativas.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />
  
  <Hero 
    subheading="CONTATO DIRETO COM ESPECIALISTA" 
    heading="SOLICITAR ORÇAMENTO OU SUPORTE CORPORATIVO"
    ctaText="IR PARA FORMULÁRIO"
    ctaLink="#contact"
  />

  <section class="page-section bg-light" style="padding: 5rem 0; border-bottom: 1px solid #dee2e6;">
    <div class="container">
      <div class="row justify-content-center text-center">
        <div class="col-md-4 mb-4 mb-md-0">
          <span class="fa-stack fa-2x mb-3 text-primary" style="color: #ffc800 !important;">
            <i class="fas fa-circle fa-stack-2x"></i>
            <i class="fas fa-phone-alt fa-stack-1x fa-inverse"></i>
          </span>
          <h5 class="fw-bold mb-2">WhatsApp de Atendimento</h5>
          <p class="text-muted m-0">+55 (16) 99999-9999</p>
        </div>
        <div class="col-md-4 mb-4 mb-md-0">
          <span class="fa-stack fa-2x mb-3 text-primary" style="color: #ffc800 !important;">
            <i class="fas fa-circle fa-stack-2x"></i>
            <i class="fas fa-envelope fa-stack-1x fa-inverse"></i>
          </span>
          <h5 class="fw-bold mb-2">E-mail Corporativo</h5>
          <p class="text-muted m-0">contato@superaplicativos.com.br</p>
        </div>
        <div class="col-md-4">
          <span class="fa-stack fa-2x mb-3 text-primary" style="color: #ffc800 !important;">
            <i class="fas fa-circle fa-stack-2x"></i>
            <i class="fas fa-map-marker-alt fa-stack-1x fa-inverse"></i>
          </span>
          <h5 class="fw-bold mb-2">Área de Atendimento</h5>
          <p class="text-muted m-0">Estado de São Paulo e Divisas</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Formulário de Contato -->
  <Contact />
  
  <Footer />
  <WhatsAppButton />
</Layout>
