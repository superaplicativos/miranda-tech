---
// src/components/Clients.astro
const base = '/miranda-tech';
---

<div class="py-5 bg-white">
  <div class="container">
    <div class="row align-items-center justify-content-center text-center">
      <div class="col-md-3 col-sm-6 my-3">
        <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src={`${base}/assets/img/logos/microsoft.svg`} alt="Microsoft" style="height: 2.7rem; filter: grayscale(100%); transition: filter 0.3s;" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='grayscale(100%)'" /></a>
      </div>
      <div class="col-md-3 col-sm-6 my-3">
        <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src={`${base}/assets/img/logos/google.svg`} alt="Google" style="height: 2.7rem; filter: grayscale(100%); transition: filter 0.3s;" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='grayscale(100%)'" /></a>
      </div>
      <div class="col-md-3 col-sm-6 my-3">
        <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src={`${base}/assets/img/logos/facebook.svg`} alt="Facebook" style="height: 2.7rem; filter: grayscale(100%); transition: filter 0.3s;" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='grayscale(100%)'" /></a>
      </div>
      <div class="col-md-3 col-sm-6 my-3">
        <a href="#!"><img class="img-fluid img-brand d-block mx-auto" src={`${base}/assets/img/logos/ibm.svg`} alt="IBM" style="height: 2.7rem; filter: grayscale(100%); transition: filter 0.3s;" onmouseover="this.style.filter='none'" onmouseout="this.style.filter='grayscale(100%)'" /></a>
      </div>
    </div>
  </div>
</div>
