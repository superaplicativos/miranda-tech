---
// src/components/BudgetCalculator.astro
const base = '/miranda-tech';
const paypalEmail = "seu-email@paypal.com"; // Configuração do PayPal
const whatsAppPhone = "+5516999999999";
---

<section class="page-section bg-dark text-white" id="calculadoras" style="background-color: #1a1d20 !important;">
  <div class="container">
    <div class="text-center">
      <h2 class="section-heading text-uppercase text-primary" style="font-weight: 700; color: #ffc800 !important;">Simulador de Orçamentos</h2>
      <h3 class="section-subheading text-muted" style="font-style: italic; margin-bottom: 4rem;">Configure seu projeto em tempo real, veja a faixa de preço e reserve a data de início instantaneamente.</h3>
    </div>

    <!-- Interface Glassmorphism -->
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <div class="card bg-secondary text-white border-0 shadow-lg" style="background: rgba(33, 37, 41, 0.95); border-radius: 12px; backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.05) !important;">
          <div class="card-header border-0 bg-transparent p-0">
            <!-- Abas do Simulador -->
            <ul class="nav nav-pills nav-fill" id="calcTabs" role="tablist" style="background: rgba(0, 0, 0, 0.2); border-radius: 12px 12px 0 0;">
              <li class="nav-item" role="presentation">
                <button class="nav-link active text-uppercase py-3 fw-bold text-white border-0" id="site-tab" data-bs-toggle="tab" data-bs-target="#site-panel" type="button" role="tab" style="border-radius: 12px 0 0 0;">
                  <i class="fas fa-desktop me-2"></i> Criar Site
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link text-uppercase py-3 fw-bold text-white border-0" id="ecommerce-tab" data-bs-toggle="tab" data-bs-target="#ecommerce-panel" type="button" role="tab" style="border-radius: 0;">
                  <i class="fas fa-shopping-cart me-2"></i> E-commerce
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link text-uppercase py-3 fw-bold text-white border-0" id="mkt-tab" data-bs-toggle="tab" data-bs-target="#mkt-panel" type="button" role="tab" style="border-radius: 0;">
                  <i class="fas fa-bullhorn me-2"></i> Marketing
                </button>
              </li>
              <li class="nav-item" role="presentation">
                <button class="nav-link text-uppercase py-3 fw-bold text-white border-0" id="video-tab" data-bs-toggle="tab" data-bs-target="#video-panel" type="button" role="tab" style="border-radius: 0 12px 0 0;">
                  <i class="fas fa-video me-2"></i> Vídeo Corp.
                </button>
              </li>
            </ul>
          </div>
          
          <div class="card-body p-4 p-md-5">
            <div class="tab-content" id="calcTabContent">
              <!-- ABA 1: CRIAÇÃO DE SITES -->
              <div class="tab-pane fade show active" id="site-panel" role="tabpanel">
                <h4 class="mb-4 text-primary" style="font-weight: 700;">Simular Criação de Site Profissional</h4>
                <div class="row">
                  <div class="col-md-7">
                    <div class="mb-4">
                      <label for="sitePages" class="form-label fw-bold d-flex justify-content-between">
                        <span>Quantidade de Páginas:</span>
                        <span class="text-primary font-weight-bold" id="sitePagesVal">5</span>
                      </label>
                      <input type="range" class="form-range" id="sitePages" min="1" max="25" value="5" style="accent-color: #ffc800;">
                      <div class="d-flex justify-content-between text-muted" style="font-size: 0.8rem;">
                        <span>1 Página (LP)</span>
                        <span>25 Páginas</span>
                      </div>
                    </div>
                    
                    <h5 class="mb-3 text-white fw-bold">Recursos Opcionais:</h5>
                    <div class="form-check mb-3">
                      <input class="form-check-input site-addon" type="checkbox" value="600" id="siteSeo" checked>
                      <label class="form-check-label" for="siteSeo">
                        Otimização SEO Completa (Indexação Orgânica no Google) (+ R$ 600,00)
                      </label>
                    </div>
                    <div class="form-check mb-3">
                      <input class="form-check-input site-addon" type="checkbox" value="500" id="siteBlog">
                      <label class="form-check-label" for="siteBlog">
                        Sistema de Blog local com Markdown (+ R$ 500,00)
                      </label>
                    </div>
                    <div class="form-check mb-3">
                      <input class="form-check-input site-addon" type="checkbox" value="800" id="siteCopy">
                      <label class="form-check-label" for="siteCopy">
                        Copywriting Técnico / Produção de Conteúdo Premium (+ R$ 800,00)
                      </label>
                    </div>
                  </div>
                  
                  <!-- Painel Lateral de Orçamento -->
                  <div class="col-md-5 mt-4 mt-md-0">
                    <div class="p-4 rounded shadow-sm" style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255,255,255,0.05);">
                      <h5 class="text-uppercase fw-bold text-center mb-3">Resumo do Orçamento</h5>
                      <hr style="background-color: rgba(255,255,255,0.1);">
                      <div class="d-flex justify-content-between mb-2">
                        <span>Valor Total:</span>
                        <span class="fw-bold fs-4 text-primary" id="siteTotal">R$ 2.450,00</span>
                      </div>
                      <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Sinal / Entrada (30%):</span>
                        <span class="fw-bold" id="siteSinal">R$ 735,00</span>
                      </div>
                      <p class="text-muted text-center" style="font-size: 0.8rem; line-height: 1.2rem;">
                        Pague o sinal via PayPal para reservar o início do seu projeto na agenda. O restante é pago após a entrega.
                      </p>
                      <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg fw-bold text-uppercase" id="btnWhatsAppSite" style="border-radius: 4px;">
                          <i class="fab fa-whatsapp me-2"></i> Solicitar via WhatsApp
                        </button>
                        <a href="#" target="_blank" class="btn btn-outline-light fw-bold text-uppercase btnPaypal" id="btnPaypalSite" style="border-radius: 4px; font-size: 0.85rem;">
                          <i class="fab fa-paypal me-2" style="color: #0070ba;"></i> Reservar via PayPal (Entrada)
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ABA 2: E-COMMERCE -->
              <div class="tab-pane fade" id="ecommerce-panel" role="tabpanel">
                <h4 class="mb-4 text-primary" style="font-weight: 700;">Simular Desenvolvimento de Loja Virtual (E-commerce)</h4>
                <div class="row">
                  <div class="col-md-7">
                    <div class="mb-4">
                      <label for="ecoProducts" class="form-label fw-bold d-flex justify-content-between">
                        <span>Número Estimado de Produtos:</span>
                        <span class="text-primary font-weight-bold" id="ecoProductsVal">50</span>
                      </label>
                      <input type="range" class="form-range" id="ecoProducts" min="10" max="500" value="50" style="accent-color: #ffc800;">
                      <div class="d-flex justify-content-between text-muted" style="font-size: 0.8rem;">
                        <span>10 Produtos</span>
                        <span>500 Produtos</span>
                      </div>
                    </div>
                    
                    <h5 class="mb-3 text-white fw-bold">Recursos Adicionais:</h5>
                    <div class="form-check mb-3">
                      <input class="form-check-input eco-addon" type="checkbox" value="500" id="ecoGate" checked>
                      <label class="form-check-label" for="ecoGate">
                        Gateways de Pagamento (Cartão, PIX, Boleto) (+ R$ 500,00)
                      </label>
                    </div>
                    <div class="form-check mb-3">
                      <input class="form-check-input eco-addon" type="checkbox" value="400" id="ecoLog" checked>
                      <label class="form-check-label" for="ecoLog">
                        Cálculo Automático de Frete (Correios/Melhor Envio) (+ R$ 400,00)
                      </label>
                    </div>
                    <div class="form-check mb-3">
                      <input class="form-check-input eco-addon" type="checkbox" value="1200" id="ecoPanel">
                      <label class="form-check-label" for="ecoPanel">
                        Painel ERP de Gestão de Estoque Avançado (+ R$ 1.200,00)
                      </label>
                    </div>
                  </div>
                  
                  <div class="col-md-5 mt-4 mt-md-0">
                    <div class="p-4 rounded shadow-sm" style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255,255,255,0.05);">
                      <h5 class="text-uppercase fw-bold text-center mb-3">Resumo do Orçamento</h5>
                      <hr style="background-color: rgba(255,255,255,0.1);">
                      <div class="d-flex justify-content-between mb-2">
                        <span>Valor Total:</span>
                        <span class="fw-bold fs-4 text-primary" id="ecoTotal">R$ 4.400,00</span>
                      </div>
                      <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Sinal / Entrada (30%):</span>
                        <span class="fw-bold" id="ecoSinal">R$ 1.320,00</span>
                      </div>
                      <p class="text-muted text-center" style="font-size: 0.8rem; line-height: 1.2rem;">
                        Garanta o início imediato de sua loja virtual efetuando o pagamento da entrada via PayPal.
                      </p>
                      <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg fw-bold text-uppercase" id="btnWhatsAppEco" style="border-radius: 4px;">
                          <i class="fab fa-whatsapp me-2"></i> Solicitar via WhatsApp
                        </button>
                        <a href="#" target="_blank" class="btn btn-outline-light fw-bold text-uppercase btnPaypal" id="btnPaypalEco" style="border-radius: 4px; font-size: 0.85rem;">
                          <i class="fab fa-paypal me-2" style="color: #0070ba;"></i> Reservar via PayPal (Entrada)
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ABA 3: MARKETING -->
              <div class="tab-pane fade" id="mkt-panel" role="tabpanel">
                <h4 class="mb-4 text-primary" style="font-weight: 700;">Simular Consultoria de Marketing Digital & Tráfego Pago</h4>
                <div class="row">
                  <div class="col-md-7">
                    <div class="mb-4">
                      <label for="mktSpend" class="form-label fw-bold d-flex justify-content-between">
                        <span>Orçamento de Mídia Mensal Recomendado (Ads):</span>
                        <span class="text-primary font-weight-bold" id="mktSpendVal">R$ 2.000</span>
                      </label>
                      <input type="range" class="form-range" id="mktSpend" min="1000" max="15000" step="500" value="2000" style="accent-color: #ffc800;">
                      <div class="d-flex justify-content-between text-muted" style="font-size: 0.8rem;">
                        <span>R$ 1.000 / mês</span>
                        <span>R$ 15.000 / mês</span>
                      </div>
                    </div>
                    
                    <h5 class="mb-3 text-white fw-bold">Escopo de Serviços:</h5>
                    <div class="form-check mb-3">
                      <input class="form-check-input mkt-addon" type="checkbox" value="1200" id="mktInsta" checked>
                      <label class="form-check-label" for="mktInsta">
                        Gestão de Instagram e Facebook Ads (Criação de Criativos Inclusa) (+ R$ 1.200,00/mês)
                      </label>
                    </div>
                    <div class="form-check mb-3">
                      <input class="form-check-input mkt-addon" type="checkbox" value="1000" id="mktGoogle" checked>
                      <label class="form-check-label" for="mktGoogle">
                        Gestão de Google Ads & YouTube Ads de Alta Performance (+ R$ 1.000,00/mês)
                      </label>
                    </div>
                    <div class="form-check mb-3">
                      <input class="form-check-input mkt-addon" type="checkbox" value="800" id="mktLp">
                      <label class="form-check-label" for="mktLp">
                        Criação de 1 Landing Page de Alta Conversão Cortesia (+ R$ 800,00 taxa única)
                      </label>
                    </div>
                  </div>
                  
                  <div class="col-md-5 mt-4 mt-md-0">
                    <div class="p-4 rounded shadow-sm" style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255,255,255,0.05);">
                      <h5 class="text-uppercase fw-bold text-center mb-3">Taxa de Gestão Mensal</h5>
                      <hr style="background-color: rgba(255,255,255,0.1);">
                      <div class="d-flex justify-content-between mb-2">
                        <span>Mensalidade Fixa:</span>
                        <span class="fw-bold fs-4 text-primary" id="mktTotal">R$ 2.200,00</span>
                      </div>
                      <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Reserva do Setup inicial:</span>
                        <span class="fw-bold" id="mktSinal">R$ 660,00</span>
                      </div>
                      <p class="text-muted text-center" style="font-size: 0.8rem; line-height: 1.2rem;">
                        A taxa de setup inclui a análise prévia do seu público-alvo, criação das contas de anúncio e pixel.
                      </p>
                      <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg fw-bold text-uppercase" id="btnWhatsAppMkt" style="border-radius: 4px;">
                          <i class="fab fa-whatsapp me-2"></i> Contratar via WhatsApp
                        </button>
                        <a href="#" target="_blank" class="btn btn-outline-light fw-bold text-uppercase btnPaypal" id="btnPaypalMkt" style="border-radius: 4px; font-size: 0.85rem;">
                          <i class="fab fa-paypal me-2" style="color: #0070ba;"></i> Contratar Setup via PayPal
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- ABA 4: PRODUÇÃO DE VÍDEOS -->
              <div class="tab-pane fade" id="video-panel" role="tabpanel">
                <h4 class="mb-4 text-primary" style="font-weight: 700;">Simular Produção de Vídeos & Audiovisual Corporativo</h4>
                <div class="row">
                  <div class="col-md-7">
                    <div class="mb-4">
                      <label for="vidMin" class="form-label fw-bold d-flex justify-content-between">
                        <span>Duração do Vídeo (Minutos):</span>
                        <span class="text-primary font-weight-bold" id="vidMinVal">2 minutos</span>
                      </label>
                      <input type="range" class="form-range" id="vidMin" min="1" max="10" value="2" style="accent-color: #ffc800;">
                      <div class="d-flex justify-content-between text-muted" style="font-size: 0.8rem;">
                        <span>1 Minuto (Reels/Comercial)</span>
                        <span>10 Minutos (Institucional Longo)</span>
                      </div>
                    </div>
                    
                    <h5 class="mb-3 text-white fw-bold">Especificidades do Audiovisual:</h5>
                    <div class="form-check mb-3">
                      <input class="form-check-input vid-addon" type="checkbox" value="500" id="vidScript" checked>
                      <label class="form-check-label" for="vidScript">
                        Roteirização Profissional & Direção Cenográfica (+ R$ 500,00)
                      </label>
                    </div>
                    <div class="form-check mb-3">
                      <input class="form-check-input vid-addon" type="checkbox" value="400" id="vidVoice">
                      <label class="form-check-label" for="vidVoice">
                        Locução em Estúdio (Voz Comercial de Alto Padrão) (+ R$ 400,00)
                      </label>
                    </div>
                    <div class="form-check mb-3">
                      <input class="form-check-input vid-addon" type="checkbox" value="800" id="vidDrone">
                      <label class="form-check-label" for="vidDrone">
                        Captação Aérea de Imagens com Drone Profissional 4K (+ R$ 800,00)
                      </label>
                    </div>
                  </div>
                  
                  <div class="col-md-5 mt-4 mt-md-0">
                    <div class="p-4 rounded shadow-sm" style="background: rgba(0, 0, 0, 0.3); border: 1px solid rgba(255,255,255,0.05);">
                      <h5 class="text-uppercase fw-bold text-center mb-3">Resumo do Orçamento</h5>
                      <hr style="background-color: rgba(255,255,255,0.1);">
                      <div class="d-flex justify-content-between mb-2">
                        <span>Valor Total:</span>
                        <span class="fw-bold fs-4 text-primary" id="vidTotal">R$ 3.700,00</span>
                      </div>
                      <div class="d-flex justify-content-between mb-3 text-muted">
                        <span>Sinal / Entrada (30%):</span>
                        <span class="fw-bold" id="vidSinal">R$ 1.110,00</span>
                      </div>
                      <p class="text-muted text-center" style="font-size: 0.8rem; line-height: 1.2rem;">
                        A entrada reserva a agenda dos cinegrafistas e o drone para a data marcada na sua empresa.
                      </p>
                      <div class="d-grid gap-2">
                        <button class="btn btn-primary btn-lg fw-bold text-uppercase" id="btnWhatsAppVid" style="border-radius: 4px;">
                          <i class="fab fa-whatsapp me-2"></i> Solicitar via WhatsApp
                        </button>
                        <a href="#" target="_blank" class="btn btn-outline-light fw-bold text-uppercase btnPaypal" id="btnPaypalVid" style="border-radius: 4px; font-size: 0.85rem;">
                          <i class="fab fa-paypal me-2" style="color: #0070ba;"></i> Reservar Diária via PayPal
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Lógica Javascript Client-side da Calculadora Estática -->
<script is:inline define:vars={{ whatsAppPhone, paypalEmail }}>
  // Executar ao carregar o DOM
  document.addEventListener('DOMContentLoaded', () => {
    
    // Configurações Gerais
    const ddiPhone = whatsAppPhone.replace('+', '');

    // GERADOR DE LINK DO PAYPAL
    function getPaypalUrl(amount, itemName) {
      const formattedAmount = amount.toFixed(2);
      return `https://www.paypal.com/cgi-bin/webscr?cmd=_xclick&business=${encodeURIComponent(paypalEmail)}&item_name=${encodeURIComponent(itemName)}&amount=${formattedAmount}&currency_code=BRL`;
    }

    // 1. CALCULADORA DE SITE
    const sitePages = document.getElementById('sitePages');
    const sitePagesVal = document.getElementById('sitePagesVal');
    const siteAddons = document.querySelectorAll('.site-addon');
    
    function updateSite() {
      const pages = parseInt(sitePages.value);
      sitePagesVal.textContent = pages;
      
      // Base: R$ 1200 + R$ 250 por página
      let total = 1200 + (pages * 250);
      let addonsList = [];
      
      siteAddons.forEach(addon => {
        if (addon.checked) {
          total += parseFloat(addon.value);
          addonsList.push(addon.nextElementSibling.textContent.trim().split(' (+')[0]);
        }
      });
      
      const sinal = total * 0.30;
      
      document.getElementById('siteTotal').textContent = `R$ ${total.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
      document.getElementById('siteSinal').textContent = `R$ ${sinal.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
      
      // URL WhatsApp
      const msg = `Olá Guilherme, fiz uma simulação de Criação de Site com ${pages} páginas no simulador da Miranda Tech.\nRecursos inclusos:\n- ${addonsList.length > 0 ? addonsList.join('\n- ') : 'Nenhum adicional'}\n\n*Valor Total estimado:* R$ ${total.toFixed(2)}\n*Valor da Entrada (30%):* R$ ${sinal.toFixed(2)}\nGostaria de fechar o projeto corporativo!`;
      document.getElementById('btnWhatsAppSite').onclick = () => {
        window.open(`https://api.whatsapp.com/send?phone=${ddiPhone}&text=${encodeURIComponent(msg)}`, '_blank');
      };
      
      // URL PayPal
      document.getElementById('btnPaypalSite').href = getPaypalUrl(sinal, `Entrada - Criação de Site (${pages} págs)`);
    }
    
    if (sitePages) {
      sitePages.addEventListener('input', updateSite);
      siteAddons.forEach(addon => addon.addEventListener('change', updateSite));
      updateSite();
    }

    // 2. CALCULADORA DE E-COMMERCE
    const ecoProducts = document.getElementById('ecoProducts');
    const ecoProductsVal = document.getElementById('ecoProductsVal');
    const ecoAddons = document.querySelectorAll('.eco-addon');
    
    function updateEcommerce() {
      const products = parseInt(ecoProducts.value);
      ecoProductsVal.textContent = products;
      
      // Base: R$ 2800 + R$ 10 por produto cadastrado
      let total = 2800 + (products * 10);
      let addonsList = [];
      
      ecoAddons.forEach(addon => {
        if (addon.checked) {
          total += parseFloat(addon.value);
          addonsList.push(addon.nextElementSibling.textContent.trim().split(' (+')[0]);
        }
      });
      
      const sinal = total * 0.30;
      
      document.getElementById('ecoTotal').textContent = `R$ ${total.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
      document.getElementById('ecoSinal').textContent = `R$ ${sinal.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
      
      // URL WhatsApp
      const msg = `Olá Guilherme, simulei uma Loja Virtual E-commerce com aprox. ${products} produtos cadastrados no site.\nRecursos:\n- ${addonsList.length > 0 ? addonsList.join('\n- ') : 'Nenhum'}\n\n*Valor Total:* R$ ${total.toFixed(2)}\n*Valor Entrada (30%):* R$ ${sinal.toFixed(2)}\nGostaria de agendar o projeto!`;
      document.getElementById('btnWhatsAppEco').onclick = () => {
        window.open(`https://api.whatsapp.com/send?phone=${ddiPhone}&text=${encodeURIComponent(msg)}`, '_blank');
      };
      
      // URL PayPal
      document.getElementById('btnPaypalEco').href = getPaypalUrl(sinal, `Entrada - E-commerce (${products} produtos)`);
    }
    
    if (ecoProducts) {
      ecoProducts.addEventListener('input', updateEcommerce);
      ecoAddons.forEach(addon => addon.addEventListener('change', updateEcommerce));
      updateEcommerce();
    }

    // 3. CALCULADORA DE MARKETING
    const mktSpend = document.getElementById('mktSpend');
    const mktSpendVal = document.getElementById('mktSpendVal');
    const mktAddons = document.querySelectorAll('.mkt-addon');
    
    function updateMarketing() {
      const spend = parseInt(mktSpend.value);
      mktSpendVal.textContent = `R$ ${spend.toLocaleString('pt-BR')}`;
      
      // Taxa base: R$ 800 + 10% do spend mensal
      let total = 800 + (spend * 0.10);
      let addonsList = [];
      
      mktAddons.forEach(addon => {
        if (addon.checked) {
          total += parseFloat(addon.value);
          addonsList.push(addon.nextElementSibling.textContent.trim().split(' (+')[0]);
        }
      });
      
      const sinal = total * 0.30;
      
      document.getElementById('mktTotal').textContent = `R$ ${total.toLocaleString('pt-BR', {minimumFractionDigits: 2})}/mês`;
      document.getElementById('mktSinal').textContent = `R$ ${sinal.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
      
      // URL WhatsApp
      const msg = `Olá Guilherme, fiz uma simulação de Tráfego Pago & Marketing Digital com orçamento de anúncios de R$ ${spend} mensais.\nEscopo do serviço:\n- ${addonsList.length > 0 ? addonsList.join('\n- ') : 'Padrão'}\n\n*Mensalidade Estimada:* R$ ${total.toFixed(2)}/mês\n*Taxa de Setup inicial:* R$ ${sinal.toFixed(2)}\nGostaria de começar!`;
      document.getElementById('btnWhatsAppMkt').onclick = () => {
        window.open(`https://api.whatsapp.com/send?phone=${ddiPhone}&text=${encodeURIComponent(msg)}`, '_blank');
      };
      
      // URL PayPal
      document.getElementById('btnPaypalMkt').href = getPaypalUrl(sinal, `Setup Inicial - Gestão Ads (Invest. R$ ${spend})`);
    }
    
    if (mktSpend) {
      mktSpend.addEventListener('input', updateMarketing);
      mktAddons.forEach(addon => addon.addEventListener('change', updateMarketing));
      updateMarketing();
    }

    // 4. CALCULADORA DE VÍDEO
    const vidMin = document.getElementById('vidMin');
    const vidMinVal = document.getElementById('vidMinVal');
    const vidAddons = document.querySelectorAll('.vid-addon');
    
    function updateVideo() {
      const minutes = parseInt(vidMin.value);
      vidMinVal.textContent = `${minutes} ${minutes === 1 ? 'minuto' : 'minutos'}`;
      
      // Base: R$ 1000 por minuto gravado
      let total = minutes * 1000;
      let addonsList = [];
      
      vidAddons.forEach(addon => {
        if (addon.checked) {
          total += parseFloat(addon.value);
          addonsList.push(addon.nextElementSibling.textContent.trim().split(' (+')[0]);
        }
      });
      
      const sinal = total * 0.30;
      
      document.getElementById('vidTotal').textContent = `R$ ${total.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
      document.getElementById('vidSinal').textContent = `R$ ${sinal.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
      
      // URL WhatsApp
      const msg = `Olá Guilherme, simulei uma Produção Audiovisual Corporativa com duração de ${minutes} minutos.\nOpcionais inclusos:\n- ${addonsList.length > 0 ? addonsList.join('\n- ') : 'Nenhum'}\n\n*Valor Total estimado:* R$ ${total.toFixed(2)}\n*Reserva de data de captação (30%):* R$ ${sinal.toFixed(2)}\nGostaria de agendar a captação na minha empresa!`;
      document.getElementById('btnWhatsAppVid').onclick = () => {
        window.open(`https://api.whatsapp.com/send?phone=${ddiPhone}&text=${encodeURIComponent(msg)}`, '_blank');
      };
      
      // URL PayPal
      document.getElementById('btnPaypalVid').href = getPaypalUrl(sinal, `Reserva Diária Audiovisual (${minutes} min)`);
    }
    
    if (vidMin) {
      vidMin.addEventListener('input', updateVideo);
      vidAddons.forEach(addon => addon.addEventListener('change', updateVideo));
      updateVideo();
    }

  });
</script>
