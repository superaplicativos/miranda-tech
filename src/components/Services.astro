---
// src/components/Services.astro
import { SERVICES } from '../data/seo-data';
const base = '/miranda-tech';
---

<section class="page-section" id="services">
  <div class="container">
    <div class="text-center">
      <h2 class="section-heading text-uppercase" style="font-weight: 700;">Nossos Serviços</h2>
      <h3 class="section-subheading text-muted" style="font-style: italic; margin-bottom: 4rem;">Tecnologia de ponta e estratégias de alta performance para impulsionar o seu faturamento orgânico.</h3>
    </div>
    
    <div class="row text-center justify-content-center">
      {Object.values(SERVICES).map((service) => (
        <div class="col-md-4 col-sm-6 mb-5" style="transition: transform 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
          <a href={`${base}/${service.key}/`} class="text-decoration-none text-dark">
            <span class="fa-stack fa-4x mb-3">
              <i class="fas fa-circle fa-stack-2x text-primary"></i>
              <i class={`fas ${service.icon} fa-stack-1x fa-inverse`}></i>
            </span>
            <h4 class="my-3" style="font-weight: 700; color: #212529;">{service.name}</h4>
          </a>
          <p class="text-muted" style="font-size: 0.95rem; line-height: 1.6rem; padding: 0 10px;">
            {service.description}
          </p>
          <a href={`${base}/${service.key}/`} class="text-primary text-decoration-none fw-bold" style="font-size: 0.9rem; letter-spacing: 0.5px;">
            Saiba Mais <i class="fas fa-arrow-right ms-1" style="font-size: 0.8rem;"></i>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
